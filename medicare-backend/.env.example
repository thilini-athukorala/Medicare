# Copy this file to ".env" and fill in your own values
PORT=5000

# Get this from MongoDB Atlas (free tier): https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medicare?retryWrites=true&w=majority

# Any long random string (used to sign JWT tokens)
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d
